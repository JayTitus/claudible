[Unit]
Description=Claudible Voice Interface
After=graphical-session.target

[Service]
Type=simple
ExecStart=@@CLAUDIBLE_BIN@@ start
ExecStop=@@CLAUDIBLE_BIN@@ stop
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=COQUI_TOS_AGREED=1
PassEnvironment=DISPLAY WAYLAND_DISPLAY XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS XDG_SESSION_TYPE

[Install]
WantedBy=graphical-session.target
