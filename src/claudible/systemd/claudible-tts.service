[Unit]
Description=Claudible TTS Server
After=network.target

[Service]
Type=simple
ExecStart=%h/miniconda3/envs/claudible/bin/claudible server
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=COQUI_TOS_AGREED=1
Environment=LD_LIBRARY_PATH=%h/miniconda3/envs/claudible/lib/python3.11/site-packages/nvidia/cudnn/lib

[Install]
WantedBy=default.target
